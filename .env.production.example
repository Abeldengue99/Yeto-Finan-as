POSTGRES_DB=yeto_financas
POSTGRES_USER=yeto_app
POSTGRES_PASSWORD=trocar_por_senha_forte

SESSION_SECRET=trocar_por_uma_chave_aleatoria_com_mais_de_32_caracteres
SESSION_TTL_SECONDS=7200
JSON_LIMIT=5mb
SYNC_BATCH_LIMIT=100

# Use o domínio final do frontend. Exemplo: https://yetofinancas.com
CORS_ORIGIN=https://seudominio.com

# Em produção com o docker-compose deste projeto, deixe vazio para usar /api no mesmo domínio.
# Se separar API em outro subdomínio, use algo como: https://api.seudominio.com
VITE_API_URL=

BREVO_SMTP_KEY=
BREVO_SENDER_NAME=Yeto Finanças
BREVO_SENDER_EMAIL=no-reply@seudominio.com
